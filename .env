# Firebase configuration for the frontend (JSON string)
VITE_FIREBASE_CONFIG="{\"apiKey\":\"your-api-key\",\"authDomain\":\"your-auth-domain\",\"projectId\":\"your-project-id\",\"storageBucket\":\"your-storage-bucket\",\"messagingSenderId\":\"your-messaging-sender-id\",\"appId\":\"your-app-id\"}"
# Optional application namespace for Firestore
VITE_APP_ID=default-app-id
# Optional custom auth token; leave empty to use anonymous auth
VITE_INITIAL_AUTH_TOKEN=

# Database credentials for the Postgres service
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb
